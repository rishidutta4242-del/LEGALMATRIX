# Server-side Gemini API key for multimodal packaging label analysis
GEMINI_API_KEY=

# Configurable Gemini model selection and resilience controls (no UI secrets)
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=18000
GEMINI_MAX_RETRIES=2

# Default Tesseract.js OCR language code (extensible, e.g. eng, eng+hin)
OCR_DEFAULT_LANG=eng
